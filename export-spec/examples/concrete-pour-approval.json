{
  "schemaVersion": "1.0",
  "id": "wf_concrete_pour",
  "name": "Concrete Pour Approval",
  "description": "Request → method statement → consultant approval → pre-pour inspection → pour.",
  "version": 1,
  "createdAt": "2026-11-04T09:00:00.000Z",
  "updatedAt": "2026-11-04T09:00:00.000Z",
  "variables": [
    {
      "name": "pourVolume",
      "type": "number",
      "default": null,
      "description": "Volume in m³"
    },
    {
      "name": "pourLocation",
      "type": "string",
      "default": null
    },
    {
      "name": "pourDate",
      "type": "date",
      "default": null
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "start",
      "category": "logic",
      "label": "Pour requested",
      "data": {
        "trigger": "form"
      },
      "outputs": [
        {
          "id": "out",
          "label": ""
        }
      ]
    },
    {
      "id": "n2",
      "type": "form",
      "category": "data",
      "label": "Pour request form",
      "data": {
        "assigneeRole": "Site Engineer",
        "fields": [
          {
            "name": "volume",
            "label": "Volume (m³)",
            "type": "number",
            "required": true,
            "variable": "pourVolume"
          },
          {
            "name": "location",
            "label": "Grid / level",
            "type": "string",
            "required": true,
            "variable": "pourLocation"
          },
          {
            "name": "date",
            "label": "Planned date",
            "type": "date",
            "required": true,
            "variable": "pourDate"
          }
        ]
      },
      "outputs": [
        {
          "id": "out",
          "label": ""
        }
      ]
    },
    {
      "id": "n3",
      "type": "document",
      "category": "construction",
      "label": "Method statement",
      "data": {
        "docType": "Method Statement",
        "action": "upload",
        "required": true,
        "description": ""
      },
      "outputs": [
        {
          "id": "out",
          "label": ""
        }
      ]
    },
    {
      "id": "n4",
      "type": "approval",
      "category": "construction",
      "label": "Consultant approval",
      "data": {
        "role": "Consultant",
        "slaHours": 48,
        "instructions": "Review the method statement for {{pourLocation}}.",
        "requireComment": true
      },
      "outputs": [
        {
          "id": "approved",
          "label": "Approved"
        },
        {
          "id": "rejected",
          "label": "Rejected"
        }
      ]
    },
    {
      "id": "n10",
      "type": "notification",
      "category": "construction",
      "label": "Ask for revision",
      "data": {
        "recipientRole": "Site Engineer",
        "channel": "email",
        "message": "Method statement for {{pourLocation}} was rejected. Please revise."
      },
      "outputs": [
        {
          "id": "out",
          "label": ""
        }
      ]
    },
    {
      "id": "n5",
      "type": "inspection",
      "category": "construction",
      "label": "Pre-pour inspection",
      "data": {
        "assigneeRole": "QA/QC Engineer",
        "checklist": [
          "Rebar spacing & cover",
          "Formwork alignment & props",
          "Embedded items / sleeves",
          "Cleanliness of formwork"
        ],
        "photosRequired": true
      },
      "outputs": [
        {
          "id": "pass",
          "label": "Pass"
        },
        {
          "id": "fail",
          "label": "Fail"
        }
      ]
    },
    {
      "id": "n11",
      "type": "assign",
      "category": "construction",
      "label": "Fix defects",
      "data": {
        "role": "Foreman",
        "department": "Civil",
        "task": "Rectify items failed in pre-pour inspection",
        "dueInDays": 1
      },
      "outputs": [
        {
          "id": "out",
          "label": ""
        }
      ]
    },
    {
      "id": "n6",
      "type": "condition",
      "category": "logic",
      "label": "Large pour?",
      "data": {
        "condition": {
          "logic": "AND",
          "rules": [
            {
              "var": "pourVolume",
              "op": ">",
              "value": 50
            }
          ]
        }
      },
      "outputs": [
        {
          "id": "true",
          "label": "True"
        },
        {
          "id": "false",
          "label": "False"
        }
      ]
    },
    {
      "id": "n7",
      "type": "notification",
      "category": "construction",
      "label": "Alert safety officer",
      "data": {
        "recipientRole": "Safety Officer",
        "channel": "inApp",
        "message": "Large pour ({{pourVolume}} m³) planned on {{pourDate}}."
      },
      "outputs": [
        {
          "id": "out",
          "label": ""
        }
      ]
    },
    {
      "id": "n8",
      "type": "task",
      "category": "logic",
      "label": "Pour concrete",
      "data": {
        "assigneeRole": "Foreman",
        "description": "Pour, compact and cure as per method statement.",
        "durationHours": 8
      },
      "outputs": [
        {
          "id": "out",
          "label": ""
        }
      ]
    },
    {
      "id": "n9",
      "type": "end",
      "category": "logic",
      "label": "Pour complete",
      "data": {
        "status": "completed"
      },
      "outputs": []
    }
  ],
