{
  "kind": "corinthia-workflow-bundle",
  "exportedAt": "2026-11-04T09:00:00.000Z",
  "workflows": [
    {
      "schemaVersion": "1.0",
      "id": "wf_slab_cycle",
      "name": "Slab Construction Cycle",
      "description": "Rebar and MEP in parallel, a design check for post-tensioned slabs, then the concrete pour workflow.",
      "version": 2,
      "createdAt": "2026-11-04T09:00:00.000Z",
      "updatedAt": "2026-11-04T09:00:00.000Z",
      "variables": [
        {
          "name": "slabLevel",
          "type": "string",
          "default": null
        },
        {
          "name": "slabType",
          "type": "string",
          "default": "rc",
          "description": "post-tensioned or rc"
        }
      ],
      "nodes": [
        {
          "id": "s1",
          "type": "start",
          "category": "logic",
          "label": "Slab cycle starts",
          "data": {
            "trigger": "event",
            "event": "slab.formwork.ready"
          },
          "outputs": [
            {
              "id": "out",
              "label": ""
            }
          ]
        },
        {
          "id": "s2",
          "type": "form",
          "category": "data",
          "label": "Slab details",
          "data": {
            "assigneeRole": "Site Engineer",
            "fields": [
              {
                "name": "level",
                "label": "Level",
                "type": "string",
                "required": true,
                "variable": "slabLevel"
              },
              {
                "name": "type",
                "label": "Slab type",
                "type": "string",
                "required": true,
                "variable": "slabType"
              }
            ]
          },
          "outputs": [
            {
              "id": "out",
              "label": ""
            }
          ]
        },
        {
          "id": "s3",
          "type": "parallel",
          "category": "logic",
          "label": "Prepare slab",
          "data": {
            "branches": 2
          },
          "outputs": [
            {
              "id": "branch_1",
              "label": "Branch 1"
            },
            {
              "id": "branch_2",
              "label": "Branch 2"
            }
          ]
        },
        {
          "id": "s4",
          "type": "assign",
          "category": "construction",
          "label": "Fix rebar",
          "data": {
            "role": "Foreman",
            "department": "Civil",
            "task": "Fix reinforcement to shop drawings",
            "dueInDays": 2
          },
          "outputs": [
            {
              "id": "out",
              "label": ""
            }
          ]
        },
        {
          "id": "s5",
          "type": "assign",
          "category": "construction",
          "label": "Install MEP sleeves",
          "data": {
            "role": "Subcontractor",
            "department": "MEP",
            "task": "Install sleeves and embeds",
            "dueInDays": 2
          },
          "outputs": [
            {
              "id": "out",
              "label": ""
            }
          ]
        },
        {
          "id": "s6",
          "type": "join",
          "category": "logic",
          "label": "Ready for pour",
          "data": {
            "mode": "all"
          },
          "outputs": [
            {
              "id": "out",
              "label": ""
            }
          ]
        },
        {
          "id": "s7",
          "type": "switch",
          "category": "logic",
          "label": "Slab type?",
          "data": {
            "variable": "slabType",
            "cases": [
              {
                "id": "case_pt",
                "value": "post-tensioned",
                "label": "Post-tensioned"
              },
              {
                "id": "case_rc",
                "value": "rc",
                "label": "RC"
              }
            ],
            "hasDefault": false
          },
          "outputs": [
            {
              "id": "case_pt",
              "label": "Post-tensioned"
            },
            {
              "id": "case_rc",
              "label": "RC"
            }
          ]
        },
        {
          "id": "s8",
          "type": "approval",
          "category": "construction",
          "label": "PT design check",
          "data": {
            "role": "Structural Engineer",
            "slaHours": 24,
            "instructions": "Check tendon profile for {{slabLevel}}",
            "requireComment": false
          },
          "outputs": [
            {
              "id": "approved",
              "label": "Approved"
            },
            {
              "id": "rejected",
              "label": "Rejected"
            }
          ]
        },
        {
          "id": "s9",
          "type": "subworkflow",
          "category": "construction",
          "label": "Concrete Pour Approval",
          "data": {
            "workflowId": "wf_concrete_pour",
            "workflowName": "Concrete Pour Approval",
            "mode": "call",
            "outcomes": [
              {
                "id": "n9",
                "label": "Pour complete"
              }
            ]
          },
          "outputs": [
            {
              "id": "n9",
              "label": "Pour complete"
            }
          ]
        },
        {
          "id": "s10",
          "type": "end",
          "category": "logic",
          "label": "Slab complete",
          "data": {
            "status": "completed"
          },
          "outputs": []
        },
        {
          "id": "s11",
          "type": "end",
          "category": "logic",
          "label": "Design rejected",
          "data": {
            "status": "rejected"
          },
          "outputs": []
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "s1",
          "sourceHandle": "out",
          "target": "s2",
          "label": ""
        },
        {
          "id": "e2",
          "source": "s2",
          "sourceHandle": "out",
          "target": "s3",
          "label": ""
        },
        {
          "id": "e3",
          "source": "s3",
          "sourceHandle": "branch_1",
          "target": "s4",
          "label": "Branch 1"
        },
        {
          "id": "e4",
          "source": "s3",
          "sourceHandle": "branch_2",
          "target": "s5",
          "label": "Branch 2"
        },
        {
          "id": "e5",
          "source": "s4",
          "sourceHandle": "out",
          "target": "s6",
          "label": ""
        },
        {
          "id": "e6",
          "source": "s5",
          "sourceHandle": "out",
          "target": "s6",
          "label": ""
        },
        {
          "id": "e7",
          "source": "s6",
          "sourceHandle": "out",
          "target": "s7",
          "label": ""
        },
        {
          "id": "e8",
          "source": "s7",
          "sourceHandle": "case_pt",
          "target": "s8",
          "label": "Post-tensioned"
        },
        {
          "id": "e9",
          "source": "s7",
          "sourceHandle": "case_rc",
          "target": "s9",
          "label": "RC"
        },
        {
          "id": "e10",
          "source": "s8",
          "sourceHandle": "approved",
          "target": "s9",
          "label": "Approved"
        },
        {
          "id": "e11",
          "source": "s8",
          "sourceHandle": "rejected",
          "target": "s11",
          "label": "Rejected"
        },
        {
          "id": "e12",
          "source": "s9",
          "sourceHandle": "n9",
          "target": "s10",
          "label": "Pour complete"
        }
      ],
      "dependencies": [
        {
          "id": "wf_concrete_pour",
          "name": "Concrete Pour Approval"
        }
      ],
      "annotations": [],
      "layout": {
        "s1": {
          "x": 0,
          "y": 100
